# CyberAware Production Environment Template
# DO NOT COMMIT REAL SECRETS OR PASSWORDS TO SOURCE CONTROL

# Secret Key (Generate strong random secret: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Database Connection (Default: sqlite:///instance/platform.db)
DATABASE_URL=

# Environment Control (production / development)
FLASK_APP=wsgi.py
FLASK_ENV=production
FLASK_DEBUG=False

# Secure Cookie Control (Set True when serving over HTTPS)
SESSION_COOKIE_SECURE=False

# Initial Admin Account Credentials (REQUIRED ON FIRST DEPLOYMENT)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@cyberaware.local
ADMIN_PASSWORD=

# Seed Demo Data (Set False in production to avoid seeding test staff and sample questions)
SEED_DEMO_DATA=False
